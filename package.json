{
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.26",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && cf-wrangler build",
    "build:preview": "CLOUDFLARE_PREVIEW_BUILD=true bun run build",
    "deploy": "cf deploy --prebuilt",
    "deploy:preview": "cf previews deploy --prebuilt",
    "preview": "astro preview --host 0.0.0.0"
  }
}
