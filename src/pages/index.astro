<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Angel Pichardo</title>
  <meta name="description" content="Junior Product Engineer. I build applications and tools that I need or think other people (mainly gamers) would find useful as well.">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400;0,500;0,600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { color-scheme: light; }
    html, body { margin: 0; height: 100%; }
    body {
      background: #f3f4f6;
      color: #1a1e24;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    :focus { outline: none; }

    .ledger {
      --ink: #1a1e24;
      --muted: #3f4854;
      --link: #18457a;
      --line: rgba(26, 30, 36, 0.12);
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      min-height: 100vh;
      background: #f3f4f6;
      color: var(--ink);
      font-family: "Familjen Grotesk", "Segoe UI", sans-serif;
      font-size: 17px;
      line-height: 1.45;
    }
    .ledger-wrap {
      max-width: 40rem;
      margin: 0 auto;
      padding: 72px 24px 64px;
    }
    .ledger-name {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .ledger h1 {
      margin: 0;
      font-size: 2.5rem;
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1.02;
    }
    .ledger-social { display: flex; gap: 2px; flex: none; }
    .ledger .ledger-social a {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      color: var(--ink);
      text-decoration: none;
      border-radius: 8px;
      transform-origin: center;
    }
    .ledger-social svg { width: 18px; height: 18px; display: block; }
    .ledger .role {
      margin: 10px 0 0;
      color: var(--muted);
    }
    .ledger .lede {
      margin: 28px 0 0;
      max-width: 36rem;
      font-size: 1.125rem;
      line-height: 1.45;
    }
    .ledger h2 {
      margin: 48px 0 0;
      font-size: 1rem;
      font-weight: 600;
    }
    .ledger-project {
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .ledger-project:first-of-type { border-top: 1px solid var(--line); margin-top: 12px; }
    .ledger-project-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: baseline;
    }
    .ledger-project-head a { display: inline-block; }
    .ledger a {
      color: var(--link);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.16em;
      transform-origin: left center;
      transition: transform 160ms var(--ease-out), color 150ms ease;
    }
    .ledger a:focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 3px;
      border-radius: 2px;
    }
    .ledger .status {
      color: var(--muted);
      font-size: 0.95rem;
      flex: none;
    }
    .ledger-project p { margin: 6px 0 0; }
    .ledger-project .stack {
      margin-top: 4px;
      color: var(--muted);
    }
    .ledger a:active { transform: scale(0.98); }
    @media (hover: hover) and (pointer: fine) {
      .ledger a:hover { color: #0f3158; }
      .ledger-social a:hover { color: var(--link); background: rgba(26, 30, 36, 0.05); }
    }
    .ledger-project {
      animation: rise 280ms var(--ease-out) both;
    }
    .ledger-project:nth-of-type(1) { animation-delay: 0ms; }
    .ledger-project:nth-of-type(2) { animation-delay: 40ms; }
    .ledger-project:nth-of-type(3) { animation-delay: 80ms; }
    .ledger-project:nth-of-type(4) { animation-delay: 120ms; }
    .ledger-project:nth-of-type(5) { animation-delay: 160ms; }
    .ledger-project:nth-of-type(6) { animation-delay: 200ms; }
    .ledger-project:nth-of-type(7) { animation-delay: 240ms; }
    .ledger-project:nth-of-type(8) { animation-delay: 280ms; }
    @keyframes rise {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
    @media (max-width: 640px) {
      .ledger h1 { font-size: 2.15rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ledger-project { animation: none; }
      .ledger a { transition: none; }
      .ledger a:active { transform: none; }
    }
  </style>
</head>
<body>
  <article class="ledger">
    <div class="ledger-wrap">
      <header class="ledger-name">
        <h1>Angel Pichardo</h1>
        <nav class="ledger-social" aria-label="Contact">
