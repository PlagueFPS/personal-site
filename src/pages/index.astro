      <h2>Open source contributions</h2>
      <section class="ledger-project">
        <div class="ledger-project-head">
          <a target="_blank" rel="noopener noreferrer" href="https://github.com/vercel/next.js/pulls?q=is%3Apr+author%3APlagueFPS+is%3Amerged">Next.js</a>
